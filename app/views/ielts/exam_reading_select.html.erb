<html lang="ar" dir="rtl">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <style>
    .cb{
      appearance:none;-webkit-appearance:none;-moz-appearance:none;
      width:22px;height:22px;border:2px solid #d8dee7;border-radius:6px;
      background:#fff;display:inline-grid;place-items:center;transition:.15s;
    }
    .cb:checked::after{content:"";width:12px;height:12px;background:#22c55e;border-radius:3px;}
    select:focus{outline:none;box-shadow:none;}
  </style>

<body class="min-h-screen bg-[#f7f9fc] text-[#1f2a37]">

  <div class="max-w-6xl mx-auto px-4 md:px-10 py-3 md:py-4">
    <div class="rounded-xl border border-gray-200 bg-white shadow-md w-full">
      <div class="max-w-7xl mx-auto px-6 md:px-10 py-3 md:py-4">

        <div class="flex items-start justify-between">
          <div class="text-[20px] md:text-[22px] font-bold text-gray-900">اختر الأقسام</div>

          <div class="flex flex-col items-center text-green-600 font-bold select-none">
            <i class="fa-solid fa-book-open text-lg"></i>
            <span class="tracking-wide">Reading</span>
          </div>
        </div>

        <div class="mt-3 flex items-start gap-3">
          <i class="fa-regular fa-lightbulb text-xl text-gray-600 relative top-[6px]"></i>
          <div class="flex flex-col text-sm">
            <span class="text-gray-400">معلومات عن قسم القراءة:</span>
            <span class="text-gray-400" dir="ltr">Questions 40 – Tasks 3 – Minutes 60</span>
          </div>
        </div>

        <div class="mt-3 h-px bg-gray-200"></div>

        <!-- الخيارات -->
        <div class="mt-4 space-y-3 text-left">
          <label dir="ltr" class="flex items-center gap-3 cursor-pointer select-none">
            <input type="checkbox" class="cb"/>
            <span class="text-[15px] text-gray-800">
              Full Reading Section (Task 1 + Task 2 + Task 3)
              <span class="text-gray-400 ml-2">40 questions</span>
            </span>
          </label>

          <label dir="ltr" class="flex items-center gap-3 cursor-pointer select-none">
            <input type="checkbox" class="cb"/>
            <span class="text-[15px] text-gray-800">
              TASK 1 <span class="text-gray-400 ml-1">15 questions</span>
            </span>
          </label>

          <label dir="ltr" class="flex items-center gap-3 cursor-pointer select-none">
            <input type="checkbox" class="cb"/>
            <span class="text-[15px] text-gray-800">
              TASK 2 <span class="text-gray-400 ml-1">15 questions</span>
            </span>
          </label>

          <label dir="ltr" class="flex items-center gap-3 cursor-pointer select-none">
            <input type="checkbox" class="cb"/>
            <span class="text-[15px] text-gray-800">
              TASK 3 <span class="text-gray-400 ml-1">15 questions</span>
            </span>
          </label>
        </div>

        <!-- السلكت -->
        <div class="mt-5">
          <div class="text-[15px] font-bold text-gray-800 mb-2">اختر الوقت لهذا القسم</div>
          <div class="relative max-w-xl">
            <select dir="ltr"
                    class="appearance-none w-full bg-gray-100 text-gray-700 border border-gray-300
                           rounded-xl py-3 px-4 text-[15px] pr-10">
              <option>Minutes 60</option>
              <option>Minutes 30</option>
              <option>Minutes 45</option>
              <option>Minutes 75</option>
              <option>Minutes 90</option>
            </select>
            <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"></i>
          </div>
        </div>

        <div class="mt-6 flex justify-end">
          <button class="flex items-center gap-2 bg-green-500 hover:bg-green-600
                         text-white font-bold px-5 py-2 rounded-lg shadow-sm transition">
            <i class="fa-solid fa-arrow-left text-sm"></i>
            <span>ابدأ الآن</span>
          </button>
        </div>

      </div>
    </div>
  </div>
