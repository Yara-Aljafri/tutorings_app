<div class="container mx-auto px-5 py-8 bg-[#e9ecf4] ">

  <%# Main wrapper for the IELTS section card %>
  <div class="flex flex-col gap-5 font-bold text-xl ">

    <%# Title of the section %>
    <div class="p-2 md:p-3">
      <div>
        <span class="text-[#e11639]">IELTS </span>Section Exams
      </div>
    </div>

    <%# Buttons to select between Academic and General exams %>
    <div class="flex gap-3 md:gap-4 text-white">
      <%# Academic button %>
      <div class="outline-[#d30328] hover:outline-2 bg-[#d30328] cursor-pointer hover:outline-offset-2 container rounded-2xl px-10 py-6 flex justify-center">
        <div>Academic</div>
      </div>
      <%# General button %>
      <div class="container outline-[#efad35] hover:outline-2 cursor-pointer hover:outline-offset-2 rounded-2xl bg-[#efad35] px-10 py-6 p-3 flex justify-center">
        <div>General</div>
      </div>
    </div>

    <%# Container for the list of IELTS mock test cards %>
    <div class="flex flex-col gap-4 md:gap-4">

      <%# Selection 1 card %>
      <div>
        <%# Top right score indicator %>
        <div class="flex justify-end px-6">
          <div class="w-20 shadow-lg/70 md:w-20 h-7 md:h-7 bg-[#e11639] text-white z-0 rounded-tl-md rounded-tr-md">
            <div class="flex justify-center drop-shadow-lg">7.5/9</div>
          </div>
        </div>
        
        <div class="flex">
          <%# Side colored stickout %>
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#d30328] rounded-tl-md rounded-bl-md"></div>
          </div>

          <%# Main card content %>
          <div class="z-20 drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <%# Test title %>
            <div>
              <div>IELTS Mock Test 1</div>
            </div>
            <%# Arrow icon on the right %>
            <div>
              <%= image_tag "Reading-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <%# Selection 2 card (same structure as selection 1) %>
      <div>
        <%# Top right score indicator %>
        <div class="flex justify-end px-6">
          <div class="w-20 md:w-20 h-7 shadow-lg/70 md:h-7 bg-[#e11639] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">7.5/9</div>
          </div>
        </div>
        
        <div class="flex">
          <%# Side colored stickout %>
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#d30328] shadow-lg rounded-tl-md rounded-bl-md"></div>
          </div>

          <%# Main card content %>
          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <div>
              <div>IELTS Mock Test 2</div>
            </div>
            <div>
              <%= image_tag "Reading-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <%# Selection 3 card %>
      <div>
        <%# Top right score indicator %>
        <div class="flex justify-end px-6">
          <div class="w-20 md:w-20 shadow-lg/70 h-7 md:h-7 bg-[#e11639] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">8.5/9</div>
          </div>
        </div>
        
        <div class="flex">
          <%# Side colored stickout %>
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#d30328] shadow-lg rounded-tl-md rounded-bl-md"></div>
          </div>

          <%# Main card content %>
          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <div>
              <div>IELTS Mock Test 3</div>
            </div>
            <div>
              <%= image_tag "Reading-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <%# Selection 4 card with 0.0 score %>
      <div>
        <div class="flex justify-end px-6">
          <div class="w-20 md:w-20 shadow-lg/70 h-7 md:h-7 bg-[#999999] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">0.0/9</div>
          </div>
        </div>

        <div class="flex">
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#d30328] shadow-lg rounded-tl-md rounded-bl-md"></div>
          </div>

          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <div>IELTS Mock Test 4</div>
            <div>
              <%= image_tag "Reading-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <%# Selection 5 card %>
      <div>
        <div class="flex justify-end px-6">
          <div class="w-20 md:w-20 h-7 md:h-7 shadow-lg/70 bg-[#999999] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">0.0/9</div>
          </div>
        </div>

        <div class="flex">
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#d30328] shadow-lg rounded-tl-md rounded-bl-md"></div>
          </div>

          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <div>IELTS Mock Test 5</div>
            <div>
              <%= image_tag "Reading-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <%# Selection 6 card %>
      <div>
        <div class="flex justify-end px-6">
          <div class="w-20 md:w-20 h-7 md:h-7 shadow-lg/70 bg-[#999999] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">0.0/9</div>
          </div>
        </div>

        <div class="flex">
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#d30328] shadow-2xl rounded-tl-md rounded-bl-md"></div>
          </div>

          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <div>IELTS Mock Test 6</div>
            <div>
              <%= image_tag "Reading-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

    </div> <%# End of selections container %>

  </div> <%# End of main flex column %>

</div> <%# End of container %>
