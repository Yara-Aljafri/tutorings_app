<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="./output.css" rel="stylesheet">
  <style>
        @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700&display=swap');
        body {
            font-family: 'Tajawal', sans-serif;
        }
    </style>
</head>
<body class="bg-blue-100 max-w-md mx-auto min-h-screen relative">
<div class="flex-col w-full">
    <div class="w-full">
        <div class="w-full flex items-start m-2">
            <p class="text-start text-red-600 font-extrabold mx-1 text-3xl">IELTS</p> <p class="font-bold text-xl mt-1.5">Mock Test 1</p>
        </div>
        <div class=" flex col">
            <div class="bg-gray-100 w-xl h-16 rtl:* rounded-bl-lg rounded-tl-lg rounded-br-lg p-2">
            <p class="text-end font-medium"> يمكنك حل الامتحان بالكامل أو اختيار أقسام محددة من الأزرار أدناه!</p>
        </div>
            <div class=" rounded-full bg-blue-900 size-7 m-2 p-4 -mt-4">

            </div>
        </div>
    </div>
</div>
<div class="row w-full my-3">
    <div class=" bg-gray-400 rounded-t-md justify-end px-2 shadow-md w-fit justify-self-end mx-2">
        <p class="text-white font-medium">0.0/9</p>
    </div>
    <div class=" bg-gray-100 rounded-md w-full flex col shadow-md">
        <div class="size-6 mt-3 ml-3">
            <img src="imgs/squares-temp.png" alt="">
        </div>
        <div class="w-full">
            <div class="flex items-start m-2">
                <p class="font-bold text-xl">Take</p><p class="text-[#df1f26] font-bold mx-1 text-xl">Full</p> <p class="font-bold text-xl">Test</p>
            </div>
            <div class=" w-full bg-gray-200 rounded-full h-5 mb-2">
                <div class="bg-gradient-to-r from-[#8e81f2] via-[#35a5dd] to-[#79c698] h-5 rounded-full relative justify-items-end" style="width: 50%">
                    <p class="my-auto mx-2 text-white">%50</p>
                </div>
            </div>
        </div>
        <div class="size-8 mt-6 mx-2">
            <img src="app/assets/images/Writing-Arrow.svg" alt="">
        </div>
    </div>
</div>
<div class="flex flex-row justify-between">
    <div class="row w-fit">
        <div class=" bg-red-600 rounded-t-md justify-end px-2 shadow-md w-fit justify-self-center mx-2">
            <p class="text-white font-medium">5.0/9</p>
        </div>
        <div class="bg-white rounded-xl px-1 shadow-sm border border-gray-100 relative">
            <div class="text-center mt-1">
                <div class="w-24 bg-[#647fe8] rounded-lg flex flex-col items-center justify-center p-4 mb-3">
                    <img src="app/assets/images/Listening-Icon.svg" alt="Listening" class="size-8 brightness-0 invert">
                    <p class="text-white font-medium">Listening</p>
                </div>
            </div>
            <div class="mt-4 flex justify-center">
                <div class="w-8 h-8 rounded-full flex items-center justify-center mb-3">
                    <img src="app/assets/images/Listening-Arrow.svg" alt="arrow">
                </div>
            </div>
        </div>
    </div>
    <div class="row w-fit">
        <div class=" bg-gray-400 rounded-t-md justify-end px-2 shadow-md w-fit justify-self-center mx-2">
            <p class="text-white font-medium">0.0/9</p>
        </div>
        <div class="bg-white rounded-xl px-1 shadow-sm border border-gray-100 relative">
            <div class="text-center mt-1">
                <div class="w-24 bg-[#79c698] rounded-lg flex flex-col items-center justify-center p-4 mb-3">
                    <img src="app/assets/images/Reading-Icon.svg" alt="Reading" class="size-8 brightness-0 invert">
                    <p class="text-white font-medium">Reading</p>
                </div>
            </div>
            <div class="mt-4 flex justify-center">
                <div class="w-8 h-8 rounded-full flex items-center justify-center mb-3">
                    <img src="app/assets/images/Reading-Arrow.svg" alt="arrow">
                </div>
            </div>
        </div>
    </div>
    <div class="row w-fit">
        <div class=" bg-red-600 rounded-t-md justify-end px-2 shadow-md w-fit justify-self-center mx-2">
            <p class="text-white font-medium">6.5/9</p>
        </div>
        <div class="bg-white rounded-xl px-1 shadow-sm border border-gray-100 relative">
            <div class="text-center mt-1">
                <div class="w-24 bg-[#35a5dd] rounded-lg flex flex-col items-center justify-center p-4 mb-3">
                    <img src="app/assets/images/Writing-Icon.svg" alt="Writing" class="size-8 brightness-0 invert">
                    <p class="text-white font-medium">Writing</p>
                </div>
            </div>
            <div class="mt-4 flex justify-center">
                <div class="w-8 h-8 rounded-full flex items-center justify-center mb-3">
                    <img src="app/assets/images/Writing-Arrow.svg" alt="arrow">
                </div>
            </div>
        </div>
    </div>
    <div class="row w-fit">
        <div class=" bg-gray-400 rounded-t-md justify-end px-2 shadow-md w-fit justify-self-center mx-2">
            <p class="text-white font-medium">0.0/9</p>
        </div>
        <div class="bg-white rounded-xl px-1 shadow-sm border border-gray-100 relative">
            <div class="text-center mt-1">
                <div class="w-24 bg-[#8e81f2] rounded-lg flex flex-col items-center justify-center p-4 mb-3">
                    <img src="app/assets/images/Speaking-Icon.svg" alt="Speaking" class="size-8 brightness-0 invert">
                    <p class="text-white font-medium">Speaking</p>
                </div>
            </div>
            <div class="mt-4 flex justify-center">
                <div class="w-8 h-8 rounded-full flex items-center justify-center mb-3">
                    <img src="app/assets/images/Speaking-Arrow.svg" alt="arrow">
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>