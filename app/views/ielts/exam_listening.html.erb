<div class="container mx-auto px-5 py-8 bg-[#e9ecf4]">
  <%# Main container for the Listening Section page %>
  
  <div class="flex flex-col gap-5 font-bold text-xl">
    <%# Card wrapper that holds the section title and all test selections %>

    <!-- Section Title -->
    <div class="p-2 md:p-3">
      <%# Padding applied, responsive for medium screens and above %>
      <div>
        <span class="text-[#6b7dbb]">Listening </span>Section Exams
        <%# "Listening" is colored specifically, the rest is default font color %>
      </div>
    </div>

    <!-- Test Selections Wrapper -->
    <div class="flex flex-col gap-4 md:gap-4">
      <%# Vertical stack of all listening test selections with spacing %>

      <!-- Selection 1 -->
      <div>
        <%# Top-right score tag (stickout) %>
        <div class="flex justify-end px-6">
          <div class="w-20 md:w-20 h-7 md:h-7 bg-[#6882e7] text-white z-0 shadow-lg/70 rounded-tl-md rounded-tr-md">
            <div class="flex justify-center drop-shadow-lg">
              7.5/9
              <%# Score for the test, styled with drop shadow for visual pop %>
            </div>
          </div>
        </div>

        <div class="flex">
          <%# Side stickout (vertical colored bar on the left) %>
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#6882e7] rounded-tl-md rounded-bl-md"></div>
          </div>

          <!-- Test Card -->
          <div class="z-20 drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <%# Card holding test title and arrow, flex row for spacing %>

            <!-- Test Title -->
            <div>
              <div>Listening Mock Test 1</div>
              <%# Name of the test %>
            </div>

            <!-- Arrow Icon -->
            <div>
              <%= image_tag "Listening-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
              <%# Arrow image to indicate navigation / clickable area %>
            </div>
          </div>
        </div>
      </div>

      <!-- Selection 2 -->
      <div>
        <%# Top-right score tag %>
        <div class="flex justify-end px-6">
          <div class="shadow-lg/70 w-20 md:w-20 h-7 md:h-7 bg-[#6882e7] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">7.5/9</div>
          </div>
        </div>

        <div class="flex">
          <%# Side stickout %>
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#6882e7] shadow-lg rounded-tl-md rounded-bl-md"></div>
          </div>

          <!-- Test Card -->
          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <!-- Test Title -->
            <div>Listening Mock Test 2</div>

            <!-- Arrow Icon -->
            <div>
              <%= image_tag "Listening-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Selection 3 -->
      <div>
        <%# Top-right score tag %>
        <div class="flex justify-end px-6">
          <div class="w-20 md:w-20 h-7 md:h-7 bg-[#6882e7] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">8.5/9</div>
          </div>
        </div>

        <div class="flex">
          <%# Side stickout %>
          <div class="flex items-center">
            <div class=" w-5 md:w-5 h-7 md:h-7 bg-[#6882e7] shadow-lg/70 rounded-tl-md rounded-bl-md"></div>
          </div>

          <!-- Test Card -->
          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <!-- Test Title -->
            <div>Listening Mock Test 3</div>

            <!-- Arrow Icon -->
            <div>
              <%= image_tag "Listening-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Selection 4 -->
      <div>
        <%# Top-right score tag (greyed out because score is 0) %>
        <div class="flex justify-end px-6">
          <div class="shadow-lg/70 w-20 md:w-20 h-7 md:h-7 bg-[#999999] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">0.0/9</div>
          </div>
        </div>

        <div class="flex">
          <%# Side stickout %>
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#6882e7] shadow-lg rounded-tl-md rounded-bl-md"></div>
          </div>

          <!-- Test Card -->
          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <!-- Test Title -->
            <div>Listening Mock Test 4</div>

            <!-- Arrow Icon -->
            <div>
              <%= image_tag "Listening-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Selection 5 -->
      <div>
        <%# Top-right score tag greyed out %>
        <div class="flex justify-end px-6">
          <div class="shadow-lg/70 w-20 md:w-20 h-7 md:h-7 bg-[#999999] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">0.0/9</div>
          </div>
        </div>

        <div class="flex">
          <%# Side stickout %>
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#6882e7] shadow-lg rounded-tl-md rounded-bl-md"></div>
          </div>

          <!-- Test Card -->
          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <!-- Test Title -->
            <div>Listening Mock Test 5</div>

            <!-- Arrow Icon -->
            <div>
              <%= image_tag "Listening-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Selection 6 -->
      <div>
        <%# Top-right score tag greyed out %>
        <div class="flex justify-end px-6">
          <div class="shadow-lg/70 w-20 md:w-20 h-7 md:h-7 bg-[#999999] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">0.0/9</div>
          </div>
        </div>

        <div class="flex">
          <%# Side stickout %>
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#6882e7] shadow-2xl rounded-tl-md rounded-bl-md"></div>
          </div>

          <!-- Test Card -->
          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <!-- Test Title -->
            <div>Listening Mock Test 6</div>

            <!-- Arrow Icon -->
            <div>
              <%= image_tag "Listening-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height:"30" %>
            </div>
          </div>
        </div>
      </div>

    </div>
    <%# End of Test Selections Wrapper %>

  </div>
  <%# End of Card Wrapper %>

</div>
<%# End of Main Container %>
