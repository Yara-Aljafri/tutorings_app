<div class="container mx-auto px-5 py-8 bg-[#e9ecf4]">
  <%# Main container for the Speaking Section page %>
  
  <div class="flex flex-col gap-5 font-bold text-xl">
    <%# Wrapper for section title and all test selection cards %>

    <!-- Section Title -->
    <div class="p-2 md:p-3">
      <%# Responsive padding, adjusts on medium screens %>
      <div>
        <span class="text-[#8380bb]">Speaking </span>Section Exams
        <%# "Speaking" is colored, rest of text follows default styling %>
      </div>
    </div>

    <!-- Test Selections Wrapper -->
    <div class="flex flex-col gap-4 md:gap-4">
      <%# Vertical stack of test cards with spacing between them %>

      <!-- Selection 1 -->
      <div>
        <%# Top-right score tag (stickout) %>
        <div class="flex justify-end px-6">
          <div class= "shadow-lg/70 w-20 md:w-20 h-7 md:h-7 bg-[#8d85ec] text-white z-0 rounded-tl-md rounded-tr-md">
            <div class="flex justify-center drop-shadow-lg">
              7.5/9
              <%# Score for the test, highlighted with a drop shadow for visual pop %>
            </div>
          </div>
        </div>

        <div class="flex">
          <%# Side stickout (vertical colored bar on the left) %>
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#8d85ec] rounded-tl-md rounded-bl-md"></div>
          </div>

          <!-- Test Card -->
          <div class="z-20 drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <%# Card containing test title and navigation arrow %>

            <!-- Test Title -->
            <div>
              <div>Speaking Mock Test 1</div>
            </div>

            <!-- Arrow Icon -->
            <div>
              <%= image_tag "Speaking-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Selection 2 -->
      <div>
        <%# Top-right score tag %>
        <div class="flex justify-end px-6">
          <div class="shadow-lg/70 w-20 md:w-20 h-7 md:h-7 bg-[#8d85ec] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">7.5/9</div>
          </div>
        </div>

        <div class="flex">
          <%# Side stickout %>
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#6882e7] shadow-lg rounded-tl-md rounded-bl-md"></div>
          </div>

          <!-- Test Card -->
          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <div>Speaking Mock Test 2</div>
            <div>
              <%= image_tag "Speaking-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Selection 3 -->
      <div>
        <%# Top-right score tag %>
        <div class="flex justify-end px-6">
          <div class="shadow-lg/70 w-20 md:w-20 h-7 md:h-7 bg-[#8d85ec] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">8.5/9</div>
          </div>
        </div>

        <div class="flex">
          <%# Side stickout %>
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#8d85ec] shadow-lg rounded-tl-md rounded-bl-md"></div>
          </div>

          <!-- Test Card -->
          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <div>Speaking Mock Test 3</div>
            <div>
              <%= image_tag "Speaking-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Selection 4 (Score 0.0, greyed out) -->
      <div>
        <div class="flex justify-end px-6">
          <div class="shadow-lg/70 w-20 md:w-20 h-7 md:h-7 bg-[#999999] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">0.0/9</div>
          </div>
        </div>

        <div class="flex">
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#8d85ec] shadow-lg rounded-tl-md rounded-bl-md"></div>
          </div>

          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <div>Speaking Mock Test 4</div>
            <div>
              <%= image_tag "Speaking-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Selection 5 (Score 0.0, greyed out) -->
      <div>
        <div class="flex justify-end px-6">
          <div class="w-20 md:w-20 h-7 md:h-7 bg-[#999999] text-white shadow-lg/70 rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">0.0/9</div>
          </div>
        </div>

        <div class="flex">
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#8d85ec] shadow-lg rounded-tl-md rounded-bl-md"></div>
          </div>

          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <div>Speaking Mock Test 5</div>
            <div>
              <%= image_tag "Speaking-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Selection 6 (Score 0.0, greyed out) -->
      <div>
        <div class="flex justify-end px-6">
          <div class="shadow-lg/70 w-20 md:w-20 h-7 md:h-7 bg-[#999999] text-white rounded-tl-md rounded-tr-md">
            <div class="flex justify-center">0.0/9</div>
          </div>
        </div>

        <div class="flex">
          <div class="flex items-center">
            <div class="w-5 md:w-5 h-7 md:h-7 bg-[#8d85ec] shadow-2xl rounded-tl-md rounded-bl-md"></div>
          </div>

          <div class="drop-shadow-sm flex flex-row bg-[#f3f3f3] justify-between container px-5 py-4 rounded-md cursor-pointer">
            <div>Speaking Mock Test 6</div>
            <div>
              <%= image_tag "Speaking-Arrow.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
            </div>
          </div>
        </div>
      </div>

    </div>
    <%# End of Test Selections Wrapper %>

  </div>
  <%# End of Card Wrapper %>

</div>
<%# End of Main Container %>
