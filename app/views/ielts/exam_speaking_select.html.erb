<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <title></title>
        <meta name="description" content="">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="">
    </head>

    <body class="relative flex flex-col bg-[#dee3ef] items-center justify-center min-h-dvh min-w-dvw">
        <div class="relative flex flex-col bg-[#f3f3f3] rounded-xl shadow-md p-6 w-full max-w-lg mx-auto">
            <!-- Section Header -->
            <div class="flex flex-row-reverse justify-between">
                <div class="flex flex-col items-end gap-2">
                    <div><h2 class="text-lg font-bold text-gray-700 m-0">اختر الأقسام</h2></div>
                    <div class="flex flex-row">
                        <div class="flex justify-start text-sm text-[#b1b1b1]"><p> معلومات عن قسم التحدث:
                            <br> Questions 20 – Tasks 3 – Minutes 13 </p> 
                        </div>
                        <div class="flex content-center"><%= image_tag "lightbulb.svg", alt: "Lightbulb", width: "30" %></div>
                    </div>
                </div>
                <div>

                    <%= image_tag "Speaking-Icon.svg", alt: "Speaking logo", width: "50" %>
                    <span class="text-[#8e81f2] font-bold">Speaking</span>
                </div>        
            </div>
            <hr class="my-4 text-[#b1b1b1]">


            <!-- Options -->
            <div class="space-y-3">
                <label for="option1" class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" id="option1" name="task-select" class="peer hidden">
                    <div class="w-5 h-5 border border-gray-300 rounded-md shadow-inner flex items-center justify-center">
                        <div class="w-3 h-3 rounded-sm bg-purple-500 hidden peer-checked:inline-block"></div>
                    </div>
                    <span class="text-gray-700"> Full Speaking Section (Task 1 + Task 2 + Task 3) 
                        <span class="text-gray-400">20 questions</span>
                    </span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="task-select" class="peer hidden">
                    <div class="w-5 h-5 border border-gray-300 rounded-md shadow-inner flex items-center justify-center">
                        <div class="w-3 h-3 rounded-sm bg-purple-500 hidden peer-checked:block"></div>
                    </div>
                    <span class="text-gray-700"> TASK 1 <span class="text-gray-400">13 questions</span>
                    </span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="task-select" class="peer hidden">
                    <div class="w-5 h-5 border border-gray-300 rounded-md shadow-inner flex items-center justify-center">
                        <div class="w-3 h-3 rounded-sm bg-purple-500 hidden peer-checked:block"></div>
                    </div>
                    <span class="text-gray-700">TASK 2 <span class="text-gray-400">1 question</span>
                    </span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="task-select" checked class="peer hidden">
                    <div class="w-5 h-5 border border-gray-300 rounded-md shadow-inner flex items-center justify-center">
                        <div class="w-3 h-3 rounded-sm bg-purple-500 hidden peer-checked:block"></div>
                    </div>
                    <span class="text-gray-700"> TASK 3 <span class="text-gray-400">6 questions</span>
                    </span>
                </label>
            </div>

            <!-- Time Selector -->
            <div class="mt-6">
                <label class="block text-gray-700 font-medium mb-2">اختر الوقت لهذا القسم</label>
                <select class="w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-purple-400">
                    <option>Minutes 32</option>
                </select>
            </div>

            <!-- Start Button -->
            <button class="w-full mt-6 bg-[#8e81f2] hover:bg-purple-400 text-white font-semibold py-2 rounded-lg">
            بدء الآن
            </button>
        </div>

    </body>
</html>
