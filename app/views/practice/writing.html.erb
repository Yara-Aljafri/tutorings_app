<div class="flex w-full justify-center">
  <!-- Main wrapper that centers content horizontally -->

  <div class="flex flex-col p-3 md:p-3">
    <!-- Vertical layout container for the card with padding -->

    <div class="bg-white rounded-md flex items-center flex-col p-5 md:p-5 gap-4 md:gap-4 z-10 shadow-lg/30">
      <!-- Content card: white background, rounded corners, centered content, shadow -->

      <div class="flex flex-row-reverse p-2 md:p-3 w-full justify-center">
        <!-- Header section: icon + title, using flex-row-reverse for RTL alignment -->

        <div class="flex rotate-45 items-center w-8 h-8 md:w-10 md:h-10">
          <!-- Rotated writing icon -->
          <%= image_tag "Writing-Icon.svg", alt: "Back Arrow", class: "object-contain object-center" %>
        </div>

        <div class="flex">
          <!-- Title container -->
          <div dir="rtl" class="rounded-lg text-[#35a5dd] text-2xl md:text-2xl font-semibold">
            نافذة تعليمات الكتابة مع لؤي!
          </div>
        </div>

      </div>

      <div>
        <!-- Character profile picture container -->
        <div class="w-24 h-24 md:w-40 md:h-40 rounded-full bg-[#4fa8de]">
          <%= image_tag "Loay.svg" %>
        </div>
      </div>

      <div class="w-full gap-3 md:gap-4 flex flex-col items-end text-lg md:text-x1">
        <!-- Instructions section (aligned to end for RTL) -->

        <div>
          <!-- "How does this exercise work?" header -->
          <div class="font-bold">كيف يعمل هذا التمرين ؟</div>
        </div>

        <div>
          <!-- Instructions list -->
          <ul dir="rtl" class="list-disc flex flex-col px-4">
            <li>
              <div class="relative left-2">
                <div dir="rtl">أجب على السؤال في نطاق <span class="font-bold">150 - 200 حرف.</span></div>
              </div>
            </li>
            <li>
              <div class="relative left-2">
                <div class="p-1" dir="rtl">إحصل على نسخة <span class="font-bold">محصصة</span> من إجابتك.</div>
              </div>
            </li>
            <li>
              <div class="relative left-2">
                <div class="p-1" dir="rtl">اكتشف ماقمت به <span class="font-bold">بشكل صحيح </span>ونقاط التحسين.</div>
              </div>
            </li>
          </ul>
        </div>

        <div>
          <!-- "How to use?" header -->
          <div class="font-bold">كيفية الاستخدام؟</div>
        </div>

        <div>
          <!-- Usage instructions list -->
          <ul dir="rtl" class="list-disc flex flex-col px-4">
            <li>
              <div class="relative left-2">
                <div class="p-1" dir="rtl">إضغط <span class="font-bold">«التالي» </span>للحصول على سؤال <span class="font-bold">جديد.</span></div>
              </div>
            </li>
            <li>
              <div class="relative left-2">
                <div class="p-1" dir="rtl">إضغط <span class="font-bold">«إرسال» </span>لرؤية تحليل <span class="font-bold">الذكاء الاصطناعي</span> عند الانتهاء.</div>
              </div>
            </li>
          </ul>
        </div>

        <div class="flex flex-row-reverse">
          <!-- Call to action: ready to start? -->
          <div>
            <%= image_tag "InfoIcon.svg", alt: "Back Arrow", class: "object-contain object-center", width: "30", height: "30" %>
          </div>
          <div class="p-1">
            <div class="font-bold" dir="rtl">جاهز لتحسين مهارتك في الكتابة؟ لنبدأ !</div>
          </div>
        </div>
      </div>

      <div class="flex flex-row-reverse justify-between items-center w-full gap-4 mt-4">
        <!-- Button row: Upgrade & Start + Progress -->

        <div class="flex flex-row-reverse justify-start gap-3 text-white w-full">
          <!-- Buttons container -->

          <div class="cursor-pointer flex flex-row-reverse justify-center items-center gap-2 bg-[#2f3c87] rounded-2xl py-2 px-4 sm:w-auto">
            <!-- Upgrade button -->
            <div class="text-sm md:text-base">ترقية</div>
            <div class="w-4 h-4 md:w-5 md:h-5">
              <%= image_tag "UpgradeArrow.svg", alt: "Back Arrow", class: "object-contain object-center" %>
            </div>
          </div>

          <div class="cursor-pointer flex flex-row-reverse justify-center items-center gap-3 bg-[#2f3c87] rounded-2xl py-2 px-4 sm:w-auto">
            <!-- Start button -->
            <div class="text-sm md:text-base">إبدأ</div>
            <div class="w-4 h-4 md:w-5 md:h-6 flex justify-end">
              <%= image_tag "LeftArrow.svg", alt: "Back Arrow", class: "object-contain object-center", width:"20", height:"20" %>
            </div>
          </div>

        </div>

        <div class="flex flex-col items-center gap-1 sm:gap-2">
          <!-- Progress indicator -->
          <div class="text-[#c0c0c0] text-base md:text-lg">1/5</div>
          <div class="flex flex-row gap-1 md:gap-2">
            <div class="w-4 h-4 md:w-5 md:h-5 rounded-full bg-[#35a5dd]"></div>
            <div class="w-4 h-4 md:w-5 md:h-5 rounded-full bg-[#35a5dd]"></div>
            <div class="w-4 h-4 md:w-5 md:h-5 rounded-full bg-[#35a5dd]"></div>
            <div class="w-4 h-4 md:w-5 md:h-5 rounded-full bg-[#d9d9d9]"></div>
            <div class="w-4 h-4 md:w-5 md:h-5 rounded-full bg-[#d9d9d9]"></div>
          </div>
        </div>

      </div>
</div>
      <div class="w-full flex px-4">
        <!-- Timer sticker -->
        <div class="flex flex-row justify-center w-32 md:w-30 bg-[#35a5dd] rounded-bl-md rounded-br-md shadow-lg md:shadow-x1 p-1 md:p-1 gap-1">
          <div class="p-1 w-7 h-7 md:w-7 md:h-7">
            <%= image_tag "Timer.svg", alt: "Back Arrow", class: "object-contain object-center", width: "20", height: "20" %>
          </div>
          <div class="text-white text-sm md:text-base">43m</div>
          <div class="text-white text-sm md:text-base">16h</div>
        </div>
      </div>

    </div> <!-- End of card -->

  </div> <!-- End of vertical container -->

</div> <!-- End of main wrapper -->
