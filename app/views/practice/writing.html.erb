<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<div class="bg-white rounded-[8px] shadow-lg px-5 py-4 w-full max-w-lg mx-auto z-10">
    <!-- top section -->
    <div class="flex justify-center gap-2 text-[#35a5dd] text-2xl">
        <h1 class="font-bold">!نافذة تعليمات الكتابة مع لؤي</h1>
        <%= image_tag "Writing-Icon.svg", class: "w-8 h-8 transform rotate-45" %>
    </div>

    <!-- middle section -->
    <div class="flex justify-center m-6">
        <i class="fa-solid fa-user-astronaut text-8xl"></i>
    </div>
    
    <!-- information section -->
    <div class="mt-4 mx-1 text-right space-y-4">
        <div>
            <h1 class="font-bold mb-1">كيف يعمل هذا التمرين؟</h1>
            <ul class="list-disc space-y-1 pr-5 [direction:rtl]">
                <li>أجب على السؤال في نطاق <span class="font-bold">150-200 حرف</span>.</li>
                <li>إحصل على نسخة <span class="font-bold">مصححة</span> من إجابتك.</li>
                <li>اكتشف ماقمت به <span class="font-bold">بشكل صحيح</span> ونقاط التحسين.</li>
            </ul>
        </div>
        <div>
            <h1 class="font-bold mb-1">كيفية الاستخدام؟</h1>
            <ul class="list-disc space-y-1 pr-5 [direction:rtl]">
                <li>اضغط <span class="font-bold">«التالي»</span> للحصول على سؤال <span class="font-bold">جديد</span>.</li>
                <li>اضغط <span class="font-bold">«إرسال»</span> لرؤية تحليل <span class="font-bold">الذكاء الاصطناعي</span> عند الانتهاء.</li>
            </ul>
        </div>

        <div class="flex flex-row justify-start font-bold mb-4 [direction:rtl]">
            <i class="fa-solid fa-lightbulb ml-2 text-[#cccccc]"></i>
            <h1>جاهز لتحسين مهاراتك في الكتابة؟ لنبدأ!</h1>
        </div>

    </div>

  <!-- bottom section -->
  <div class="flex items-center justify-between mt-3 text-white">
    <!-- dots -->
    <div>
      <h1 class="text-[#c0c0c0]"><sup class="text-sm">1/5<sup></h1>
      <ul class="flex flex-row gap-1">
        <li class="w-3 h-3 rounded-full bg-[#35a5dd]"></li>
        <li class="w-3 h-3 rounded-full bg-[#35a5dd]"></li>
        <li class="w-3 h-3 rounded-full bg-[#35a5dd]"></li>
        <li class="w-3 h-3 rounded-full bg-[#d9d9d9]"></li>
        <li class="w-3 h-3 rounded-full bg-[#d9d9d9]"></li>
      </ul>
    </div>

    <!-- buttons -->
    <div class="flex gap-x-2 [direction:rtl]">
      <button class="bg-[#2d3a84] rounded-[15px] py-2 px-3 cursor-pointer ">
        ترقية
        <i class="fa-solid fa-angles-up pr-1"></i>
      </button>

      <button class="bg-[#2d3a84] rounded-[15px] py-2 px-3 cursor-pointer">
        إبدأ
        <i class="fa-solid fa-arrow-left pr-1"></i>
      </button>
    </div>
  </div>
</div>

<div class="w-full max-w-lg mx-auto z-0">
  <div class="flex justify-start pl-[20px] -mt-[4px]">
    <div class="flex items-center p-[6px] rounded-[4px] bg-[#35a5dd] text-white">
      <i class="fa-regular fa-clock mr-[8px]"></i
      <span>43m 16h</span>
    </div>
  </div>
</div>