<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<div class="bg-white rounded-[8px] shadow-lg px-5 py-4 w-full max-w-lg mx-auto z-10">

   <!-- top section -->
  <div class="flex justify-center gap-2 text-[#8e81f2] text-2xl">
    <h1 class="font-bold">!تحدث مع رياض</h1>
    <!-- <i class="fa-solid fa-comment-dots"></i> -->
    <%= image_tag "Speaking-Icon.svg", class: "w-8 h-8" %>
  </div>
  <div class="mt-3">
    <h1 class="flex justify-center text-xl ">ممارسة المحادثة مع الذكاء الإصطناعي</h1>
  </div>

  <!-- middle section -->
  <div class="flex justify-center mt-16 mb-16">
    <i class="fa-solid fa-user-astronaut text-8xl"></i>
  </div>

  <!-- information section -->
  <div class="flex justify-end mt-8 mx-3">
    <ul class="list-disc space-y-1 [direction:rtl]">
        <li>مارس المحادثات الحقيقية مع رياض. شريكك الذكي في التحدث!</li>
        <li>تحدث بحرية وحسن طلاقتك</li>
        <li>احصل على ملاحظات فورية حول النطق والقواعد</li>
        <li>
            <span>بعد الانتهاء اضغط على</span>
            <i class="fa-regular fa-circle-check text-[#2d3a84]"></i>
            <span>للحصول على تقييم مفصل!</span>
        </li>
        <li>مدة التحدث محدودة</li>
        <li>قم بالترقية للحصول على جلسات تدريب غير محدودة!</li>
    </ul>
  </div>

  <!-- bottom section -->
  <div class="flex items-center justify-between mt-3 text-white">
    <!-- dots -->
    <div>
      <h1 class="text-[#c0c0c0]"><sup class="text-sm">1/5<sup></h1>
      <ul class="flex flex-row gap-1 space-y-1">
        <li class="w-3 h-3 rounded-full bg-[#8e81f2]"></li>
        <li class="w-3 h-3 rounded-full bg-[#8e81f2]"></li>
        <li class="w-3 h-3 rounded-full bg-[#8e81f2]"></li>
        <li class="w-3 h-3 rounded-full bg-[#d9d9d9]"></li>
        <li class="w-3 h-3 rounded-full bg-[#d9d9d9]"></li>
      </ul>
    </div>

    <!-- buttons -->
    <div class="flex gap-x-2 [direction:rtl]">
      <button class="bg-[#2d3a84] rounded-[15px] py-2 px-3 cursor-pointer ">
        ترقية
        <i class="fa-solid fa-angles-up pr-1"></i>
      </button>

      <button class="bg-[#2d3a84] rounded-[15px] py-2 px-3 cursor-pointer">
        إبدأ
        <i class="fa-solid fa-arrow-left pr-1"></i>
      </button>
    </div>
  </div>
</div>

<div class="w-full max-w-lg mx-auto z-0">
  <div class="flex justify-start pl-[20px] -mt-[4px]">
    <div class="flex items-center p-[6px] rounded-[4px] bg-[#8e81f2] text-white">
      <i class="fa-regular fa-clock mr-[8px]"></i
      <span>43m 16h</span>
    </div>
  </div>
</div>